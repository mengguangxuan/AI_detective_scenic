    "facts": [
      {
        "id": "fact_desk",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "【周四初勘记录】上校被发现伏在书桌前，头部有枪伤，桌上和地面有血迹。桌上有一座倒下的座钟和一张未写完的纸。初勘时未发现枪。"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_desk"
      },
      {
        "id": "fact_clock",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "座钟已经扶正，指针停在18:22。初勘记录上写着：发现时钟倒在书桌上，停在同一读数。"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_clock"
      },
      {
        "id": "fact_paper",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "【原件由警方保管】\n纸张上方标着18:20。\n“亲爱的克莱门特：抱歉，我不能再等下去了，我必须……”\n后面的字迹拖成了一道潦草的笔痕。"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_paper"
      },
      {
        "id": "fact_habit",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "克莱门特：“那座钟我一直拨快一刻钟。昨晚我想跟斯莱克说这件事，可他根本不让我插话。”"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_habit"
      },
      {
        "id": "fact_discovery",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "克莱门特：“我回来时快七点了，具体几分我记不清了。在门外我遇见雷丁，他脸色很难看。进了书房，我才看见上校。我让玛丽去请海多克医生，他检查过以后报了警。”"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_discovery"
      },
      {
        "id": "fact_call",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "克莱门特：“有人打电话，说病人快不行了，要我赶紧过去。可我到那里一看，病人比前几天还好些。他太太说，她根本没给我打过电话。”"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_call"
      },
      {
        "id": "fact_arrival",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "玛丽：“六点一刻。我把上校带进书房，之后就回厨房忙自己的活了。”"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
        "sources": [
          "source_ch5"
        ],
        "topic": "topic_arrival"
      },
      {
        "id": "fact_arrival_basis",
        "value": {
          "kind": "AuthoredDetail",
          "detail": "玛丽：“我没看书房的钟。我刚把他带进去，就听见教堂报时了。”"
        },
        "requiresOccurred": [],
        "explanation": "固定的初查材料；陈述及推论的归属见正文，不等同于完整案件真相。",
